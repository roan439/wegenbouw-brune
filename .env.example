# Publieke basis-URL (voor canonical, sitemap en OG-afbeeldingen)
NEXT_PUBLIC_SITE_URL=https://construction-redesign.vercel.app

# E-mailverzending via Resend (https://resend.com) — server-side, nooit in de browser
RESEND_API_KEY=
# Afzender moet een geverifieerd domein bij Resend zijn
CONTACT_FROM_EMAIL="Website Construction Redesign <website@example.com>"
# Ontvanger van offerteaanvragen
CONTACT_TO_EMAIL=info@example.com

# Optioneel: Cloudflare Turnstile (extra spambescherming). Laat leeg om uit te schakelen.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Geheime sleutel voor het ondertekenen van het formuliertoken (lange willekeurige string)
FORM_SIGNING_SECRET=
